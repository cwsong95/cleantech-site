{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/en/sub/aqua_crete.php",
      "destination": "/product/aqua-crete",
      "permanent": true
    },
    {
      "source": "/sub/aqua_crete.php",
      "destination": "/product/aqua-crete",
      "permanent": true
    },
    { "source": "/en/:path*", "destination": "/", "permanent": true },
    { "source": "/sub/:path*", "destination": "/", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/_empty.html" }],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
