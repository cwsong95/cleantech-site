<div class="hero-stack">
  {{#each this.slides key="id" as |slide|}}
    <section class="hero-section" data-slide-id={{slide.id}}>
      <div class="hero-slide__inner">
        <div class="hero-slide__content">
          <div class="hero-slide__copy">
            <p class="hero-slide__kicker">{{slide.kicker}}</p>
            <p class="hero-slide__lead">{{slide.titleLead}}</p>
            <h1 class="hero-slide__title">{{slide.product}}</h1>
          </div>
          <div class="hero-slide__actions">
            {{#each slide.ctas as |cta|}}
              <LinkTo @route={{cta.route}} class="hero-slide__link">
                {{cta.label}}
              </LinkTo>
            {{/each}}
          </div>
        </div>
        <div class="hero-slide__visual">
          <img
            src={{slide.image}}
            alt={{slide.imageAlt}}
            class="hero-slide__image"
          >
        </div>
      </div>
    </section>
  {{/each}}
</div>
