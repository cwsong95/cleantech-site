<div class="swiper hero-bg-swiper" id={{this.sliderId}}>
  <div class="swiper-wrapper">
    {{#each this.slides as |slide|}}
      <div class="swiper-slide" data-slide-id={{slide.id}}>
        <img
          src={{slide.src}}
          alt={{slide.alt}}
          class="hero-bg-image"
          loading="lazy"
        />
      </div>
    {{/each}}
  </div>
</div>