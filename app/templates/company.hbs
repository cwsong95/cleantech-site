{{page-title
  (if this.locale.isKorean "회사 소개 | CleanTech" "About Us | CleanTech")
}}

<section class="space-y-16 margin-page">
  <nav
    class="rounded-3xl border border-slate-200 bg-white/90 p-5 shadow-lg shadow-blue-500/10 backdrop-blur"
    aria-label={{if
      this.locale.isKorean
      "회사 페이지 빠른 이동"
      "Company page quick access"
    }}
  >
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center">
      <div class="flex flex-none items-center gap-4">
        <div
          class="flex h-12 w-12 flex-col justify-center gap-2 rounded-2xl bg-slate-50 px-3"
          aria-hidden="true"
        >
          <span class="h-0.5 w-7 rounded-full bg-slate-900"></span>
          <span class="h-0.5 w-5 rounded-full bg-slate-300"></span>
          <span class="h-0.5 w-6 rounded-full bg-slate-300"></span>
        </div>
        <div>
          <p
            class="text-xs font-semibold uppercase tracking-[0.35em] text-blue-600"
          >Quick Access</p>
          <h2 class="text-xl font-bold text-slate-900">
            {{if this.locale.isKorean "빠른 이동" "Quick links"}}
          </h2>
        </div>
      </div>
      <div class="flex flex-1 flex-wrap gap-2">
        <a
          href="#company-location"
          class="inline-flex items-center rounded-full border border-blue-100 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 shadow-sm transition hover:bg-blue-100"
        >
          {{if this.locale.isKorean "찾아오시는 길" "Location"}}
        </a>
        <a
          href="#company-timeline"
          class="inline-flex items-center rounded-full border border-blue-100 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 shadow-sm transition hover:bg-blue-100"
        >
          {{this.copy.timelineTitle}}
        </a>
        {{#each this.timeline as |block|}}
          <a
            href={{concat "#history-" block.year}}
            class="inline-flex min-w-16 items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
          >
            {{block.year}}
          </a>
        {{/each}}
      </div>
    </div>
  </nav>

  <section
    id="company-location"
    class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm"
  >
    <div
      class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-[0.35em] text-blue-600"
        >
          {{if this.locale.isKorean "위치" "Location"}}
        </p>
        <h2
          class="text-2xl font-bold text-slate-900"
        >{{this.copy.map.title}}</h2>
        <p class="text-sm text-slate-600">{{this.copy.map.description}}</p>
      </div>
      <a
        href="https://www.google.com/maps/search/?api=1&query=37.4857086%2C127.1204659"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 shadow-sm transition hover:bg-blue-100"
      >
        {{this.copy.map.linkLabel}}
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-4 w-4 fill-current"
        >
          <path
            d="M13 5a1 1 0 0 0 0 2h3.59l-9.3 9.29a1 1 0 1 0 1.42 1.42L18 8.41V12a1 1 0 0 0 2 0V6a1 1 0 0 0-1-1h-6Z"
          />
        </svg>
      </a>
    </div>
    <div
      class="company-map relative overflow-hidden rounded-2xl border border-slate-200 bg-slate-50"
    >
      <iframe
        title={{if this.locale.isKorean "회사 위치 지도" "Company map"}}
        src="https://www.google.com/maps?q=37.4857086,127.1204659&z=16&output=embed"
        class="absolute inset-0 h-full w-full"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>

  <section id="company-timeline" class="space-y-10">
    <div class="flex items-center justify-between gap-4">
      <h2
        class="text-2xl font-semibold text-slate-900"
      >{{this.copy.timelineTitle}}</h2>
      <div
        class="hidden items-center gap-2 rounded-full bg-slate-100 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-slate-500 sm:flex"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-4 w-4 fill-slate-400"
        ><path
            d="M5 5a1 1 0 0 0 0 2h14a1 1 0 1 0 0-2H5Zm0 6a1 1 0 0 0 0 2h9a1 1 0 1 0 0-2H5Zm0 6a1 1 0 0 0 0 2h4a1 1 0 1 0 0-2H5Z"
          /></svg>
        <span>{{if
            this.locale.isKorean
            "2012년부터 2026년까지"
            "2012 to 2026"
          }}</span>
      </div>
    </div>

    <div
      class="relative pl-6 before:absolute before:bottom-0 before:top-0 before:left-2 before:w-px before:bg-gradient-to-b before:from-blue-200 before:via-slate-200 before:to-slate-200"
    >
      <div class="space-y-10">
        {{#each this.timeline as |block|}}
          <article
            id={{concat "history-" block.year}}
            class="relative grid gap-6 rounded-3xl border border-slate-200/80 bg-white/80 p-6 shadow-sm backdrop-blur"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-11 w-11 items-center justify-center rounded-full bg-blue-600 text-lg font-semibold text-white shadow-lg shadow-blue-500/40"
              >
                {{block.year}}
              </div>
              <div
                class="text-sm font-medium uppercase tracking-[0.2em] text-slate-400"
              >{{if this.locale.isKorean "연혁" "Milestone"}}</div>
            </div>
            <ul class="space-y-3 text-slate-700 list-none p-0">
              {{#each block.entries as |entry|}}
                <li class="flex items-start gap-3 leading-relaxed">
                  <span
                    class="mt-2 h-2 w-2 flex-none rounded-full bg-blue-600"
                    aria-hidden="true"
                  ></span>
                  <span>{{entry}}</span>
                </li>
              {{/each}}
            </ul>
          </article>
        {{/each}}
      </div>
    </div>
  </section>

</section>