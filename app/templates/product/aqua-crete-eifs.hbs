                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </LinkTo>
            <LinkTo @route="downloads" class="ac-btn ac-btn--ghost">브로슈어 /
              카탈로그</LinkTo>
          </div>
        </div>
      </section>
