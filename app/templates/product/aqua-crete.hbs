{{#if this.locale.isKorean}}
  <article class="aqua-crete-page page ac-page full-bleed" {{aqua-reveal}}>
    {{! ================= HERO ================= }}
    <section class="ac-hero">
      <div class="ac-hero__bg" aria-hidden="true">
        <img src="/images/aqua-crete-hero-white.jpg" alt="" />
      </div>
      <div class="ac-inner ac-hero__grid">
        <div class="ac-hero__content">
          <p class="ac-hero__eyebrow">AQUA-CRETE
            <span>Safer · Faster · Harder</span></p>
          <p class="ac-hero__kicker">수용성 무기불연재 세라믹 방수 바닥 마감재</p>
          <h1 class="ac-hero__title">아쿠아크리트<span
              class="ac-reg"
            >®</span></h1>
          <p class="ac-hero__lead">
            {{break-lines
              "Safer, Faster, Harder. 냉·온이 반복되는 고위생 현장에서 빠른 시공과 뛰어난 내구성을 동시에 제공하는 Cleantech의 대표 바닥 솔루션입니다."
            }}
          </p>
          <ul class="ac-hero__tags" aria-label="핵심 슬로건">
            <li>위생 관리 최적화</li>
            <li>24h 빠른 재가동</li>
            <li>폴리싱 마감 기술</li>
          </ul>
          <div class="ac-hero__cta">
            <LinkTo @route="contact" class="ac-btn ac-btn--primary">도입 상담
              요청
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </LinkTo>
            <LinkTo @route="downloads" class="ac-btn ac-btn--ghost">브로슈어 /
              SDS 보기
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" /></svg>
            </LinkTo>
          </div>
        </div>
        <aside class="ac-hero__panel" aria-label="슬로건 및 인증">
          <div class="ac-hero__sfh"><span>Safer</span><i>·</i><span
            >Faster</span><i>·</i><span>Harder</span></div>
          <div class="ac-badges">
            <div class="ac-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M9 11l3 3L22 4" /><path
                  d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
                /></svg>
              <span><b>HACCP Certified</b></span>
            </div>
            <div class="ac-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"
                /><path d="M2 21c0-3 1.85-5.36 5.08-6" /></svg>
              <span><b>친환경 바닥재</b></span>
            </div>
            <div class="ac-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z" /><path
                  d="M8 12l2.5 2.5L16 9"
                /></svg>
              <span><b>Food Safety</b></span>
            </div>
          </div>
        </aside>
      </div>
      <div class="ac-metrics">
        <div class="ac-inner ac-metrics__grid">
          <div class="ac-metric"><div class="ac-metric__n"><span
                data-count="24"
              >0</span><em>h</em></div><div class="ac-metric__l">빠른 재가동</div></div>
          <div class="ac-metric"><div class="ac-metric__n"><span
                data-count="100"
              >0</span><em>%</em></div><div class="ac-metric__l">무기계 불연
              성분</div></div>
          <div class="ac-metric"><div class="ac-metric__n">영하</div><div
              class="ac-metric__l"
            >영하 기온 시공</div></div>
          <div class="ac-metric"><div class="ac-metric__n">습윤</div><div
              class="ac-metric__l"
            >함수비 습윤면 시공</div></div>
        </div>
      </div>
    </section>

    <div class="margin-page">
      {{! ================= 인증 ================= }}
      <section class="ac-sec ac-certs">
        <div class="ac-certrow ac-reveal">
          <div class="ac-certs__label">공인 인증 · 시험<b>NEP · 친환경 ·
              녹색기술 · KS</b></div>
          <div class="ac-certlist">
            <div class="ac-cert"><figure><img
                  src="/images/cert-eco.jpg"
                  alt="환경표지 인증서"
                  loading="lazy"
                /></figure><figcaption>환경표지 인증</figcaption></div>
            <div class="ac-cert"><figure><img
                  src="/images/cert-green-tech.jpg"
                  alt="녹색기술 인증서"
                  loading="lazy"
                /></figure><figcaption>녹색기술 인증</figcaption></div>
            <div class="ac-cert"><figure><img
                  src="/images/cert-quality.jpg"
                  alt="품질 인증서"
                  loading="lazy"
                /></figure><figcaption>품질 인증</figcaption></div>
            <div class="ac-cert"><figure><img
                  src="/images/cert-ks.jpg"
                  alt="KS 인증서"
                  loading="lazy"
                /></figure><figcaption>KS 인증</figcaption></div>
          </div>
        </div>
      </section>

      {{! ================= 개념 ================= }}
      <section class="ac-sec ac-concept" id="concept">
        <div class="ac-concept__grid">
          <div class="ac-concept__aside ac-reveal">
            <span class="ac-eyebrow">Concept</span>
            <h2>아쿠아크리트<br />개념</h2>
            <div class="ac-keychips">
              <span class="ac-keychip">100% 무기계 불연재</span>
              <span class="ac-keychip">고어텍스 기능</span>
              <span class="ac-keychip">강력한 부착력</span>
              <span class="ac-keychip">무취 시공</span>
            </div>
          </div>
          <div class="ac-concept__body ac-reveal" data-d="1">
            <p>100% 무기계 불연재 성분으로 구성된 파우더 바인더와 수용 액상을
              이용하여 시설구조물
              바탕면(콘크리트(시멘트몰탈),조적,타일,드라이비트마감 등)에 드라이
              건조상태 또는 물에 젖은 상태(함수비 100%)에서 바탕면에 불연재
              아쿠아크리트를 미장 또는 스프레이뿜칠 등의 방법으로 시공하는
              마감재입니다.</p>
            <div class="ac-nep">
              <p>신제품(NEP) 불연재 아쿠아크리트는 100% 불연성 재료의 사용으로
                화재시 불에 타지 않고 유독가스가 발생하지 않으며 통기성 및
                방수성(고어텍스 기능)이 우수하고, 시공시 냄새 발생이 없는
                바탕면과의 강력한 부착력을 발휘하는 무기 불연 방수 성능을
                발현하는 마감재입니다.</p>
            </div>
          </div>
        </div>
      </section>

      {{! ================= 시공 현장 (슬라이더) ================= }}
      <section class="ac-sec ac-gallery" id="gallery">
        <div class="ac-head ac-reveal">
          <span class="ac-eyebrow">Gallery</span>
          <h2>시공 현장</h2>
        </div>
        <div class="ac-gallery__panel ac-reveal" data-d="1">
          <AcSlider />
        </div>
      </section>

      {{! ================= 특징 ================= }}
      <section class="ac-sec ac-features" id="features">
        <div class="ac-head ac-reveal">
          <span class="ac-eyebrow">Features</span>
          <h2>아쿠아크리트 특징</h2>
          <p>극한 환경에서도 시공과 운영이 가능한 특장점을 한눈에 확인해 보세요.</p>
        </div>
        <div class="ac-fgrid">
          <article class="ac-fcard ac-reveal" data-d="1">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"
                /><path d="M9.5 14a2.5 2.5 0 0 0 2.5 2.5" /></svg></div>
            <h3>습윤면 시공</h3>
            <p>바탕면이 드라이 건조상태 및 물에 항시 노출되어 있는(함수비100%)
              바탕면에 직접 시공가능</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="2">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M10 13.5V5a2 2 0 1 1 4 0v8.5a4 4 0 1 1-4 0z"
                /></svg></div>
            <h3>영하 기온 시공</h3>
            <p>동절기 영하온도 환경에서도 완벽한 경화반응으로 시공이 가능함</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="3">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><circle cx="12" cy="13" r="8" /><path
                  d="M12 9v4l3 2M9 2h6M12 5V2"
                /></svg></div>
            <h3>초속경화</h3>
            <p>제품 시공 후 빠른 시간내에 경화가 이루어져 후속공정작업이 가능함</p>
          </article>
          <article class="ac-fcard is-signature ac-reveal" data-d="4">
            <span class="ac-flag">GORE-TEX®</span>
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M3 14h18M3 18h18" /><path
                  d="M7 11V6M12 11V4M17 11V6"
                /><path
                  d="M5.5 8.5L7 6l1.5 2.5M10.5 6.5L12 4l1.5 2.5M15.5 8.5L17 6l1.5 2.5"
                /></svg></div>
            <h3>방수·통기 성능</h3>
            <p>구조체 속에 함유된 수분이 도막층을 투과하여 수분이 배출되는
              성능(통기성)과 물이 침투하지 못하는 성능(방수성)</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="1">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M4 17l5-1 3.5 1.5L21 14" /><path d="M3 20h18" /><path
                  d="M9 16l1.5-4.5 3 1 1.2-3.2"
                /><circle cx="15.5" cy="6.5" r="1.5" /></svg></div>
            <h3>영구적인 미끄럼방지성능</h3>
            <p>아쿠아크리트 도막층에 수분 접촉과 동시에 영구적인 미끄럼방지
              성능을 발휘함</p>
          </article>
          <article class="ac-fcard is-signature ac-reveal" data-d="2">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M12 3s5 4.5 5 9a5 5 0 0 1-10 0c0-1.6.6-3 1.4-4.2"
                /><path d="M4 4l16 16" /></svg></div>
            <h3>불연재 성능</h3>
            <p>불에 타지 않는 무기계 불연소재로 구성되어 화재로부터 안전함</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="3">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M9 3h6M10 3v6l-5 8.5A2 2 0 0 0 6.7 21h10.6a2 2 0 0 0 1.7-3.5L14 9V3"
                /><path d="M7.5 15h9" /></svg></div>
            <h3>내화학성 및 오염방지성능</h3>
            <p>산, 알카리 내성이 우수하며 염해 및 염분에도 물성변화가 없으며
              오염방지 성능이 우수함</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="4">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"
                /><path d="M2 21c0-3 1.85-5.36 5.08-6" /></svg></div>
            <h3>친환경 바닥재</h3>
            <p>VOC 발생이 없는 유해물질 감소로 인한 친환경 불연 마감재</p>
          </article>
        </div>
      </section>

      {{! ================= 층별 구조 ================= }}
      <section class="ac-sec ac-structure" id="structure">
        <div class="ac-head ac-reveal">
          <span class="ac-eyebrow">Structure</span>
          <h2>층별 구조</h2>
        </div>
        <div class="ac-struct-grid">
          <figure class="ac-diagram ac-reveal">
            <svg
              viewBox="0 0 520 340"
              role="img"
