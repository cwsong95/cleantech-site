{{#if this.locale.isKorean}}
  <article class="aqua-crete-page page ac-page full-bleed" {{aqua-reveal}}>
    {{! ================= HERO ================= }}
    <section class="ac-hero ac-hero--photo">
      <div class="ac-hero__bg" aria-hidden="true">
        <img src="/images/aqua-crete-hero.jpg" alt="" />
      </div>
      <div class="ac-inner ac-hero__grid ac-hero__grid--solo">
        <div class="ac-hero__content">
          <h1 class="ac-hero__titleimg">
            <img src="/images/aqua-crete-hero-title.png" alt="" />
            <span class="ac-sr-only">아쿠아크리트 신제품(NEP) 불연 바닥재 —
              Safer, Faster, Harder</span>
          </h1>
        </div>
        <div class="ac-hero__certs" aria-hidden="true"><img
            src="/images/cert-nep.png"
            alt=""
          /><img src="/images/cert-eco.png" alt="" /><img
            src="/images/cert-green.png"
            alt=""
          /><img src="/images/cert-ktr.png" alt="" /></div>
      </div>
      <div class="ac-metrics">
        <div class="ac-inner ac-metrics__grid">
          <div class="ac-metric"><div class="ac-metric__n"><span
                data-count="24"
              >0</span><em>h</em></div><div class="ac-metric__l">빠른 재가동</div></div>
          <div class="ac-metric"><div class="ac-metric__n"><span
                data-count="100"
              >0</span><em>%</em></div><div class="ac-metric__l">무기계 불연
              성분</div></div>
          <div class="ac-metric"><div class="ac-metric__n">영하</div><div
              class="ac-metric__l"
            >영하 기온 시공</div></div>
          <div class="ac-metric"><div class="ac-metric__n">습윤</div><div
              class="ac-metric__l"
            >함수비 습윤면 시공</div></div>
        </div>
      </div>
    </section>

    <div class="margin-page">
      {{! ================= 인증 ================= }}

      {{! ================= 개념 ================= }}
      <section class="ac-sec ac-concept" id="concept">
        <div class="ac-concept__grid">
          <div class="ac-concept__aside ac-reveal">
            <span class="ac-eyebrow">Concept</span>
            <h2>아쿠아크리트 개념</h2>
            <div class="ac-keychips">
              <span class="ac-keychip">100% 무기계 불연재</span>
              <span class="ac-keychip">고어텍스 기능</span>
              <span class="ac-keychip">강력한 부착력</span>
              <span class="ac-keychip">무취 시공</span>
            </div>
          </div>
          <div class="ac-concept__body ac-reveal" data-d="1">
            <p>100% 무기계 불연재 성분으로 구성된 파우더 바인더와 수용 액상을
              이용하여 시설구조물
              바탕면(콘크리트(시멘트몰탈),조적,타일,드라이비트마감 등)에 드라이
              건조상태 또는 물에 젖은 상태(함수비 100%)에서 바탕면에 불연재
              아쿠아크리트를 미장 또는 스프레이뿜칠 등의 방법으로 시공하는
              마감재입니다.</p>
            <p>신제품(NEP) 불연재 아쿠아크리트는 100% 불연성 재료의 사용으로
              화재시 불에 타지 않고 유독가스가 발생하지 않으며 통기성 및
              방수성(고어텍스 기능)이 우수하고, 시공시 냄새 발생이 없는
              바탕면과의 강력한 부착력을 발휘하는 무기 불연 방수 성능을 발현하는
              마감재입니다.</p>
          </div>
        </div>
      </section>

      {{! ================= 구조도 ================= }}
      <section class="ac-sec ac-diagram-sec">
        <div class="ac-concept__grid">
          <div class="ac-concept__aside ac-reveal">
            <span class="ac-eyebrow">Concept</span>
            <h2>아쿠아크리트 개념</h2>
          </div>
        </div>
        <div class="ac-inner">
          <figure class="ac-diagram-fig ac-reveal">

            <img
              src="/images/aqua-crete-structure.png"
              alt="아쿠아크리트 구조도"
              loading="lazy"
            />
          </figure>
        </div>
      </section>

      {{! ================= 특징 ================= }}
      <section class="ac-sec ac-features" id="features">
        <div class="ac-head ac-reveal">
          <span class="ac-eyebrow">Features</span>
          <h2>아쿠아크리트 특징</h2>
          <p>극한 환경에서도 시공과 운영이 가능한 특장점을 한눈에 확인해 보세요.</p>
        </div>
        <div class="ac-fgrid">
          <article class="ac-fcard ac-reveal" data-d="1">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"
                /><path d="M9.5 14a2.5 2.5 0 0 0 2.5 2.5" /></svg></div>
            <h3>습윤면 시공</h3>
            <p>바탕면이 드라이 건조상태 및 물에 항시 노출되어 있는(함수비100%)
              바탕면에 직접 시공가능</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="2">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M10 13.5V5a2 2 0 1 1 4 0v8.5a4 4 0 1 1-4 0z"
                /></svg></div>
            <h3>영하 기온 시공 및 강력한 부착력</h3>
            <p>동절기 영하온도 환경에서 시공이 가능하며 제품 시공 후 빠른
              시간내에 경화가 이루어져 후속공정작업이 가능함</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="3">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><rect x="3" y="7.5" width="18" height="9" rx="1.5" /><path
                  d="M7.5 7.5v9M12 7.5v9M16.5 7.5v9"
                /></svg></div>
            <h3>트렌치 주위 완벽보가</h3>
            <p>트렌치 주위의 탈락부위를 완벽히 보강하여 강력한 부착력 및 완벽한
              방수성능을 유지함</p>
          </article>
          <article class="ac-fcard is-signature ac-reveal" data-d="4">
            <span class="ac-flag">GORE-TEX®</span>
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M3 14h18M3 18h18" /><path
                  d="M7 11V6M12 11V4M17 11V6"
                /><path
                  d="M5.5 8.5L7 6l1.5 2.5M10.5 6.5L12 4l1.5 2.5M15.5 8.5L17 6l1.5 2.5"
                /></svg></div>
            <h3>방수·통기 성능</h3>
            <p>구조체 속에 함유된 수분이 도막층을 투과하여 수분이 배출되는
              성능(통기성)과 물이 침투하지 못하는 성능(방수성)</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="1">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M4 17l5-1 3.5 1.5L21 14" /><path d="M3 20h18" /><path
                  d="M9 16l1.5-4.5 3 1 1.2-3.2"
                /><circle cx="15.5" cy="6.5" r="1.5" /></svg></div>
            <h3>영구적인 미끄럼방지성능</h3>
            <p>아쿠아크리트 도막층에 수분 접촉과 동시에 영구적인 미끄럼방지
              성능을 발휘함</p>
          </article>
          <article class="ac-fcard is-signature ac-reveal" data-d="2">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M12 3s5 4.5 5 9a5 5 0 0 1-10 0c0-1.6.6-3 1.4-4.2"
                /><path d="M4 4l16 16" /></svg></div>
            <h3>불연재 성능</h3>
            <p>불에 타지 않는 무기계 불연소재로 구성되어 화재로부터 안전함</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="3">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M9 3h6M10 3v6l-5 8.5A2 2 0 0 0 6.7 21h10.6a2 2 0 0 0 1.7-3.5L14 9V3"
                /><path d="M7.5 15h9" /></svg></div>
            <h3>내화학성 및 오염방지성능</h3>
            <p>산, 알카리 내성이 우수하며 염해 및 염분에도 물성변화가 없으며
              오염방지 성능이 우수함</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="4">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"
                /><path d="M2 21c0-3 1.85-5.36 5.08-6" /></svg></div>
            <h3>친환경 바닥재</h3>
            <p>VOC 발생이 없는 유해물질 감소로 인한 친환경 불연 마감재</p>
          </article>
        </div>
      </section>

      {{! ================= 시공 현장 (슬라이더) ================= }}
      <section class="ac-sec ac-gallery" id="gallery">
        <div class="ac-head ac-reveal">
          <span class="ac-eyebrow">Gallery</span>
          <h2>Steps & Gallery</h2>
        </div>
        <div class="ac-gallery__panel ac-reveal" data-d="1">
          <AcGalleryTabs @isKorean={{this.locale.isKorean}} />
        </div>
      </section>

      {{! ================= CALLOUT ================= }}
      <section class="ac-sec ac-callout" id="callout">
        <div class="ac-callout__box ac-reveal">
          <div>
            <h2>Safer · Faster · Harder</h2>
            <p>CleanTech (주)크린텍개발은 아쿠아크리트 전문 시공팀과 유지관리
              서비스를 통해 설계부터 검수까지 한 번에 지원합니다. 현장 진단이
              필요하시다면 언제든지 연락 주세요.</p>
          </div>
          <div class="ac-callout__cta">
            <LinkTo @route="contact" class="ac-btn ac-btn--primary">현장 컨설팅
              신청
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </LinkTo>
            <LinkTo @route="downloads" class="ac-btn ac-btn--ghost">브로슈어 /
              SDS 보기</LinkTo>
          </div>
        </div>
      </section>
    </div>
  </article>
{{else}}
  <article class="aqua-crete-page page ac-page full-bleed" {{aqua-reveal}}>
    {{! ================= HERO ================= }}
    <section class="ac-hero ac-hero--photo">
      <div class="ac-hero__bg" aria-hidden="true">
        <img src="/images/aqua-crete-hero.jpg" alt="" />
      </div>
      <div class="ac-inner ac-hero__grid ac-hero__grid--solo">
        <div class="ac-hero__content">
          <h1 class="ac-hero__titleimg">
            <img src="/images/aqua-crete-hero-title.png" alt="" />
            <span class="ac-sr-only">Aqua-Crete — New Excellent Product (NEP)
              non-combustible flooring · Safer, Faster, Harder</span>
          </h1>
        </div>
        <div class="ac-hero__certs" aria-hidden="true"><img
            src="/images/cert-nep.png"
            alt=""
          /><img src="/images/cert-eco.png" alt="" /><img
            src="/images/cert-green.png"
            alt=""
          /><img src="/images/cert-ktr.png" alt="" /></div>
      </div>
      <div class="ac-metrics">
        <div class="ac-inner ac-metrics__grid">
          <div class="ac-metric"><div class="ac-metric__n"><span
                data-count="24"
              >0</span><em>h</em></div><div class="ac-metric__l">Rapid
              turnaround</div></div>
          <div class="ac-metric"><div class="ac-metric__n"><span
                data-count="100"
              >0</span><em>%</em></div><div class="ac-metric__l">Inorganic &amp;
              non-combustible</div></div>
          <div class="ac-metric"><div class="ac-metric__n">Sub-zero</div><div
              class="ac-metric__l"
            >Cold-weather install</div></div>
          <div class="ac-metric"><div class="ac-metric__n">Wet</div><div
              class="ac-metric__l"
            >Saturated-surface install</div></div>
        </div>
      </div>
    </section>

    <div class="margin-page">
      {{! ================= CERTIFICATIONS ================= }}
      <section class="ac-sec ac-certs">
        <div class="ac-certrow ac-reveal">
          <div class="ac-certs__label">Certified · Tested<b>NEP · Eco ·
              Green-Tech · KS</b></div>
          <div class="ac-certlist">
            <div class="ac-cert"><figure><img
                  src="/images/cert-eco.jpg"
                  alt="Eco-Label certificate"
                  loading="lazy"
                /></figure><figcaption>Eco-Label</figcaption></div>
            <div class="ac-cert"><figure><img
                  src="/images/cert-green-tech.jpg"
                  alt="Green Technology certificate"
                  loading="lazy"
                /></figure><figcaption>Green Tech</figcaption></div>
            <div class="ac-cert"><figure><img
                  src="/images/cert-quality.jpg"
                  alt="Quality certificate"
                  loading="lazy"
                /></figure><figcaption>Quality</figcaption></div>
            <div class="ac-cert"><figure><img
                  src="/images/cert-ks.jpg"
                  alt="KS certificate"
                  loading="lazy"
                /></figure><figcaption>KS</figcaption></div>
          </div>
        </div>
      </section>

      {{! ================= CONCEPT ================= }}
      <section class="ac-sec ac-concept" id="concept">
        <div class="ac-concept__grid">
          <div class="ac-concept__aside ac-reveal">
            <span class="ac-eyebrow">Concept</span>
            <h2>Aqua-Crete<br />Concept</h2>
            <div class="ac-keychips">
              <span class="ac-keychip">100% inorganic</span>
              <span class="ac-keychip">GORE-TEX® function</span>
              <span class="ac-keychip">Strong adhesion</span>
              <span class="ac-keychip">Odor-free</span>
            </div>
          </div>
          <div class="ac-concept__body ac-reveal" data-d="1">
            <p>Aqua-Crete blends a 100% inorganic, non-combustible ceramic
              binder powder with a water-based liquid, allowing direct placement
              on saturated concrete (100% moisture) and foot traffic after
              roughly one hour. Strong adhesion, high compressive strength, and
              a GORE-TEX®-style breathable waterproof function protect the base,
              while the odor-free, non-toxic chemistry delivers ultra-fast cure
              as an eco-friendly inorganic ceramic waterproof floor topping.</p>
          </div>
        </div>
      </section>

      {{! ================= STRUCTURE DIAGRAM ================= }}
      <section class="ac-sec ac-diagram-sec">
        <div class="ac-inner">
          <figure class="ac-diagram-fig ac-reveal">
            <img
              src="/images/aqua-crete-structure.png"
              alt="Aqua-Crete structure diagram"
              loading="lazy"
            />
          </figure>
        </div>
      </section>

      {{! ================= GALLERY (slider) ================= }}
      <section class="ac-sec ac-gallery" id="gallery">
        <div class="ac-head ac-reveal">
          <span class="ac-eyebrow">Gallery</span>
          <h2>On-Site Gallery</h2>
        </div>
        <div class="ac-gallery__panel ac-reveal" data-d="1">
          <AcGalleryTabs @isKorean={{this.locale.isKorean}} />
        </div>
      </section>

      {{! ================= FEATURES ================= }}
      <section class="ac-sec ac-features" id="features">
        <div class="ac-head ac-reveal">
          <span class="ac-eyebrow">Features</span>
          <h2>Performance Highlights</h2>
          <p>Engineered to perform in extreme wet, cold, and chemically
            aggressive production environments.</p>
        </div>
        <div class="ac-fgrid">
          <article class="ac-fcard ac-reveal" data-d="1">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"
                /><path d="M9.5 14a2.5 2.5 0 0 0 2.5 2.5" /></svg></div>
            <h3>Wet-Surface Placement</h3>
            <p>Installs directly on saturated slabs without priming and
              maintains adhesion inside chillers or wash-down zones.</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="2">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M10 13.5V5a2 2 0 1 1 4 0v8.5a4 4 0 1 1-4 0z"
                /></svg></div>
            <h3>Low-Temperature Cure</h3>
            <p>Reliable cure from -4°F to 122°F (-20°C to 50°C) covering freezer
              docks and steam-cleaned areas alike.</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="3">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><circle cx="12" cy="13" r="8" /><path
                  d="M12 9v4l3 2M9 2h6M12 5V2"
                /></svg></div>
            <h3>Rapid Turnaround</h3>
            <p>Production can resume in ~24 hours, minimizing downtime for busy
              processing plants.</p>
          </article>
          <article class="ac-fcard is-signature ac-reveal" data-d="4">
            <span class="ac-flag">GORE-TEX®</span>
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M3 14h18M3 18h18" /><path
                  d="M7 11V6M12 11V4M17 11V6"
                /><path
                  d="M5.5 8.5L7 6l1.5 2.5M10.5 6.5L12 4l1.5 2.5M15.5 8.5L17 6l1.5 2.5"
                /></svg></div>
            <h3>Waterproof &amp; Breathable</h3>
            <p>Vapor channels vent moisture while the waterproof layer stops
              blistering caused by upward hydrostatic pressure.</p>
          </article>
          <article class="ac-fcard ac-reveal" data-d="1">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M4 17l5-1 3.5 1.5L21 14" /><path d="M3 20h18" /><path
                  d="M9 16l1.5-4.5 3 1 1.2-3.2"
                /><circle cx="15.5" cy="6.5" r="1.5" /></svg></div>
            <h3>Slip-Control Options</h3>
            <p>From textured matte to polished gloss, the surface can be tuned
              for safety and cleanability.</p>
          </article>
          <article class="ac-fcard is-signature ac-reveal" data-d="2">
            <div class="ac-fcard__ic"><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path
                  d="M12 3s5 4.5 5 9a5 5 0 0 1-10 0c0-1.6.6-3 1.4-4.2"
                /><path d="M4 4l16 16" /></svg></div>
            <h3>Non-Combustible Strength</h3>
            <p>Inorganic ceramic composition resists flame spread and survives
