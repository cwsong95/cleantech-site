            <li>Anti-Slip 마감</li>
          </ul>
          <div class="ac-hero__cta">
            <LinkTo @route="contact" class="ac-btn ac-btn--primary">도입 상담
              요청
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M5 12h14M13 6l6 6-6 6" /></svg>
