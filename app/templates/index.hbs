{{page-title
  (if
    this.locale.isKorean
    "크린텍개발 | 산업 바닥 솔루션"
    "CleanTech | Industrial Flooring"
  )
}}

<div class="ac-page ac-home full-bleed" {{aqua-reveal}}>
  {{! ================= HERO ================= }}
  <section class="ac-home-hero">
    <div class="ac-home-hero__bg" aria-hidden="true">
      <HeroBgSlider />
      <div class="ac-home-hero__overlay"></div>
    </div>
    <div class="ac-inner ac-home-hero__inner">
      <span class="ac-home-hero__eyebrow">{{this.heroCopy.eyebrow}}</span>
      <h1 class="ac-home-hero__title">{{this.heroCopy.title}}</h1>
      <p class="ac-home-hero__lead">{{break-lines this.heroCopy.lead}}</p>
      <div class="ac-home-hero__cta">
        <LinkTo @route="product.aqua-crete" class="ac-btn ac-btn--primary">
          {{this.heroCopy.ctaPrimary}}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </LinkTo>
        <LinkTo @route="contact" class="ac-btn ac-btn--ghost">
          {{this.heroCopy.ctaSecondary}}
        </LinkTo>
      </div>
      <ul class="ac-home-hero__highlights">
        {{#each this.heroCopy.highlights as |item|}}
          <li class="ac-reveal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            <span>{{item}}</span>
          </li>
        {{/each}}
      </ul>
    </div>
  </section>

  {{! ================= PRODUCTS ================= }}
  <section class="ac-sec ac-home-products">
    <div class="ac-inner">
      <div class="ac-head ac-head--center ac-reveal">
        <span class="ac-eyebrow">
          {{if this.locale.isKorean "제품 한눈에 보기" "Products at a glance"}}
        </span>
        <h2>
          {{if
            this.locale.isKorean
            "크린텍 제품"
            "CleanTech product lineup"
          }}
        </h2>
        <p>
          {{break-lines
            (if
              this.locale.isKorean
              "현장 조건과 요구 성능에 맞춰 선택할 수 있도록 대표 솔루션을 모았습니다."
              "Pick the right system for your site — fast turnarounds, heavy loads, or warm natural finishes."
            )
          }}
        </p>
      </div>

      <div class="ac-prod-grid">
        {{#each this.products as |product|}}
          <article class="ac-prod ac-reveal {{if product.comingSoon 'is-soon'}}">
            <div class="ac-prod__media">
              <img src={{product.image}} alt={{product.imageAlt}} loading="lazy" />
              <span class="ac-prod__badge">{{product.badge}}</span>
              {{#if product.comingSoon}}
                <div class="ac-prod__soon" aria-hidden="true">
                  <span class="ac-prod__soon-badge">{{product.comingSoonLabel}}</span>
                </div>
              {{/if}}
            </div>
            <div class="ac-prod__body">
              <div class="ac-prod__head">
                <h3>{{product.title}}</h3>
                {{#if product.comingSoon}}
                  <span class="ac-prod__pill">{{product.comingSoonLabel}}</span>
                {{/if}}
              </div>
              <p class="ac-prod__desc">{{product.description}}</p>
              {{#if product.comingSoon}}
                <p class="ac-prod__note">
                  {{if
                    this.locale.isKorean
                    "페이지가 준비 중입니다. 문의를 통해 먼저 안내받으세요."
                    "Page is in progress. Contact us for early details."
                  }}
                </p>
              {{/if}}
              <ul class="ac-prod__points">
                {{#each product.points as |point|}}
                  <li>{{point}}</li>
                {{/each}}
              </ul>
              {{#if product.comingSoon}}
                <span class="ac-prod__soon-pill" role="status">
                  {{product.comingSoonLabel}}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v4l3 2" /></svg>
                </span>
              {{else}}
                <LinkTo @route={{product.route}} class="ac-prod__link">
                  {{product.linkLabel}}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </LinkTo>
              {{/if}}
            </div>
          </article>
        {{/each}}
      </div>
    </div>
  </section>

  {{! ================= CONTACT ================= }}
  <section class="ac-sec ac-home-contact">
    <div class="ac-inner">
      <div class="ac-contact-card ac-reveal">
        <div class="ac-contact-info">
          <span class="ac-eyebrow">{{this.contactCopy.eyebrow}}</span>
          <h2>{{this.contactCopy.title}}</h2>
          <p class="ac-contact-info__lead">{{break-lines
              this.contactCopy.description
            }}</p>

          <ul class="ac-contact-bullets">
            {{#each this.contactCopy.bullets as |item|}}
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                <span>{{item}}</span>
              </li>
            {{/each}}
          </ul>

          <div class="ac-contact-direct">
            <div class="ac-contact-direct__title">{{this.contactCopy.directTitle}}</div>
            <div class="ac-contact-direct__desc">{{this.contactCopy.directDesc}}</div>
            <div class="ac-contact-direct__links">
              <a href="tel:024202844">02-420-2844~5</a>
              <a href="mailto:ct4138605@gmail.com">ct4138605@gmail.com</a>
            </div>
          </div>
        </div>

        <form class="ac-form" {{on "submit" this.submitForm}}>
          <div class="ac-form__grid">
            <label class="ac-field">
              <span>{{this.contactCopy.nameLabel}}</span>
              <input
                type="text"
                value={{this.name}}
                required
                {{on "input" (fn this.updateField "name")}}
              />
            </label>
            <label class="ac-field">
              <span>{{this.contactCopy.emailLabel}}</span>
              <input
                type="email"
                value={{this.email}}
                required
                {{on "input" (fn this.updateField "email")}}
              />
            </label>
            <label class="ac-field">
              <span>{{this.contactCopy.phoneLabel}}</span>
              <input
                type="text"
                value={{this.phone}}
                placeholder="010-1234-5678"
                {{on "input" (fn this.updateField "phone")}}
              />
            </label>
            <label class="ac-field">
              <span>{{this.contactCopy.companyLabel}}</span>
              <input
                type="text"
                value={{this.company}}
                {{on "input" (fn this.updateField "company")}}
              />
            </label>
          </div>

          <label class="ac-field">
            <span>{{this.contactCopy.messageLabel}}</span>
            <textarea
              value={{this.message}}
              required
              placeholder={{this.contactCopy.messagePlaceholder}}
              {{on "input" (fn this.updateField "message")}}
            ></textarea>
          </label>

          {{#if this.isSuccess}}
            <div class="ac-form__msg--ok">{{this.contactCopy.successMessage}}</div>
          {{/if}}
          {{#if this.isError}}
            <div class="ac-form__msg--err">{{this.errorMessage}}</div>
          {{/if}}

          <button
            type="submit"
            class="ac-form__submit"
            disabled={{this.submitDisabled}}
          >
            {{#if this.isSubmitting}}
              <svg class="ac-form__spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.22-8.56" /></svg>
            {{/if}}
            <span>{{this.buttonLabel}}</span>
          </button>

          <p class="ac-form__note">{{this.contactCopy.privacyNote}}</p>
        </form>
      </div>
    </div>
  </section>
</div>
