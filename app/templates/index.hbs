<section class="hero">
  <div class="container-app">
    <HeroCarousel />
  </div>
</section>

<section class="section">
  <div class="container-app">
    <div class="flex flex-wrap gap-3">
      {{#each this.sections as |section|}}
        <button
          type="button"
          class={{if (this.isSelected section.id) "btn" "btn-ghost"}}
          data-product-id={{section.id}}
          aria-pressed={{if (this.isSelected section.id) "true" "false"}}
          {{on "click" (fn this.selectSection section.id)}}
        >
          {{section.title}}
        </button>
      {{/each}}
    </div>
  </div>
</section>

{{#if this.activeSection}}
  <section class="section">
    <div class="container-app" data-product-id={{this.activeSection.id}}>
      <div
        class="space-y-3 md:flex md:items-start md:justify-between md:gap-10"
      >
        <div class="space-y-3">
          <h2
            class="text-3xl font-bold leading-tight text-slate-900"
          >{{this.activeSection.title}}</h2>
          <p
            class="text-base leading-relaxed text-slate-600"
          >{{this.activeSection.description}}</p>
          <div class="md:hidden">
            <LinkTo
              @route={{this.activeSection.route}}
              class="btn mt-2"
            >{{this.activeSection.ctaLabel}}</LinkTo>
          </div>
        </div>
        <div
          class="hidden md:flex md:flex-col md:items-end md:gap-2 text-sm text-slate-500"
        >
          <span
            class="rounded-full border border-slate-200 px-3 py-1 font-semibold text-slate-700"
          >{{this.activeSection.eyebrow}}</span>
          <LinkTo
            @route={{this.activeSection.route}}
            class="btn mt-3"
          >{{this.activeSection.ctaLabel}}</LinkTo>
        </div>
      </div>

      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {{#each this.activeSection.cards as |card|}}
          <LinkTo
            @route={{this.activeSection.route}}
            class="card block"
            data-card-id={{card.id}}
          >
            <div class="card-title">{{card.title}}</div>
            <p class="card-text">{{card.description}}</p>
            <span
              class="inline-flex items-center gap-2 text-sm font-semibold text-blue-700 mt-3"
            >
              {{this.activeSection.ctaLabel}}
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-4 w-4 fill-current"
              ><path
                  d="M13 5a1 1 0 1 0 0 2h3.59l-9.3 9.29a1 1 0 0 0 1.42 1.42L18 8.41V12a1 1 0 0 0 2 0V6a1 1 0 0 0-1-1h-6Zm-9 8a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h5a1 1 0 0 0 0-2H5v-4a1 1 0 0 0-1-1Z"
                /></svg>
            </span>
          </LinkTo>
        {{/each}}
      </div>
    </div>
  </section>

  <section
    class="section gallery-section"
    aria-label={{this.activeSection.galleryLabel}}
  >
    <div class="container-app">
      <div class="mb-6 flex flex-col gap-2">
        <h3
          class="text-2xl font-semibold leading-tight text-slate-900"
        >{{this.activeSection.galleryLabel}}</h3>
      </div>
      <GallerySlider @slides={{this.activeSlides}} />
    </div>
  </section>
{{/if}}