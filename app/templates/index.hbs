{{page-title
  (if
    this.locale.isKorean
    "크린텍개발 | 산업 바닥 솔루션"
    "Cleantech | Industrial Flooring"
  )
}}

<section class="home-hero relative isolate overflow-hidden text-white">
  <div class="absolute inset-0">
    <HeroBgSlider />
    <div
      class="absolute inset-0 bg-gradient-to-r from-emerald-950/90 via-emerald-900/75 to-emerald-800/55"
    ></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_18%_20%,rgba(255,255,255,0.12),transparent_45%)]"
    ></div>
  </div>

  <div class="container-app relative z-10 py-16 sm:py-20 lg:py-28">
    <div class="mx-auto max-w-screen-xl px-4 sm:px-6">
      <div class="max-w-4xl space-y-6">
        <span
          class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.32em] text-emerald-50 ring-1 ring-white/20"
        >
          {{this.heroCopy.eyebrow}}
        </span>
        <h1
          class="text-4xl font-extrabold leading-tight sm:text-5xl lg:text-6xl"
        >
          {{this.heroCopy.title}}
        </h1>
        <p
          class="max-w-3xl text-lg leading-relaxed text-emerald-50/90 sm:text-xl"
        >
          {{this.heroCopy.lead}}
        </p>
        <div class="flex flex-wrap gap-3">
          <LinkTo
            @route="product.aqua-crete"
            class="inline-flex items-center gap-2 rounded-full bg-emerald-400 px-5 py-3 text-sm font-semibold text-emerald-950 shadow-lg shadow-emerald-500/30 transition hover:bg-emerald-300"
          >
            {{this.heroCopy.ctaPrimary}}
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="h-4 w-4 fill-current"
            >
              <path
                d="M13 5a1 1 0 1 0 0 2h3.59l-9.3 9.29a1 1 0 0 0 1.42 1.42L18 8.41V12a1 1 0 0 0 2 0V6a1 1 0 0 0-1-1h-6Z"
              />
            </svg>
          </LinkTo>
          <LinkTo
            @route="contact"
            class="inline-flex items-center gap-2 rounded-full bg-white/10 px-5 py-3 text-sm font-semibold text-white ring-1 ring-inset ring-white/30 transition hover:bg-white/15"
          >
            {{this.heroCopy.ctaSecondary}}
          </LinkTo>
        </div>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {{#each this.heroCopy.highlights as |item|}}
          <div
            class="flex items-center gap-3 rounded-2xl bg-white/8 px-4 py-3 ring-1 ring-white/10 backdrop-blur-sm"
          >
            <span
              class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-400/15 text-emerald-100 ring-1 ring-emerald-200/40"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-5 w-5 fill-current"
              >
                <path
                  d="M20.71 5.29a1 1 0 0 0-1.42 0L9 15.59l-4.29-4.3a1 1 0 0 0-1.42 1.42l5 5a1 1 0 0 0 1.42 0l11-11a1 1 0 0 0 0-1.42Z"
                />
              </svg>
            </span>
            <span class="text-sm font-medium text-emerald-50">{{item}}</span>
          </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>
<div class="main-below">
  <section class="section bg-slate-50">
    <div class="container-app space-y-10">
      <div class="space-y-3 text-center">
        <p
          class="text-xs font-semibold uppercase tracking-[0.26em] text-emerald-600"
        >{{if
            this.locale.isKorean
            "제품 한눈에 보기"
            "Products at a glance"
          }}</p>
        <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
          {{if
            this.locale.isKorean
            "크린텍 제품 포트폴리오"
            "Cleantech product lineup"
          }}
        </h2>
        <p class="mx-auto max-w-3xl text-lg leading-relaxed text-slate-600">
          {{if
            this.locale.isKorean
            "현장 조건과 요구 성능에 맞춰 선택할 수 있도록 대표 솔루션을 모았습니다."
            "Pick the right system for your site — fast turnarounds, heavy loads, or warm natural finishes."
          }}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {{#each this.products as |product|}}
          <div
            class="group product-card relative overflow-hidden rounded-3xl bg-white shadow-lg shadow-emerald-100 ring-1 ring-slate-100 transition hover:-translate-y-1 hover:shadow-emerald-200
              {{if product.comingSoon 'product-card--coming-soon'}}"
          >
            <div
              class="product-card__media relative aspect-[4/3] overflow-hidden bg-slate-100"
            >
              <img
                src={{product.image}}
                alt={{product.imageAlt}}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.05]"
              />
              <span
                class="absolute right-4 top-4 inline-flex items-center gap-2 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-emerald-700 shadow-sm ring-1 ring-emerald-100"
              >
                {{product.badge}}
              </span>
              {{#if product.comingSoon}}
                <div class="product-card__overlay" aria-hidden="true">
                  <span
                    class="product-card__overlay-text"
                  >{{product.comingSoonLabel}}</span>
                </div>
              {{/if}}
            </div>
            <div class="space-y-3 px-5 py-5">
              <div class="space-y-1">
                <h3 class="text-xl font-semibold text-slate-900">
                  {{product.title}}
                </h3>
                <p class="text-sm leading-relaxed text-slate-600">
                  {{product.description}}
                </p>
              </div>
              <ul class="space-y-2 text-sm text-slate-700">
                {{#each product.points as |point|}}
                  <li class="flex items-center gap-2">
                    <span
                      class="h-1.5 w-1.5 rounded-full bg-emerald-500"
                    ></span>
                    <span>{{point}}</span>
                  </li>
                {{/each}}
              </ul>
              {{#if product.comingSoon}}
                <div
                  class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-500 ring-1 ring-slate-200"
                  role="status"
                  aria-label={{product.comingSoonLabel}}
                >
                  {{product.comingSoonLabel}}
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    class="h-4 w-4 fill-current"
                  >
                    <path
                      d="M12 4a8 8 0 1 0 8 8 8.01 8.01 0 0 0-8-8Zm1 4a1 1 0 1 0-2 0v3.2a1 1 0 0 0 .45.83l2.4 1.6a1 1 0 0 0 1.1-1.66L13 11.7Z"
                    />
                  </svg>
                </div>
              {{else}}
                <LinkTo
                  @route={{product.route}}
                  class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 transition hover:text-emerald-600"
                >
                  {{product.linkLabel}}
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    class="h-4 w-4 fill-current"
                  >
                    <path
                      d="M13 5a1 1 0 1 0 0 2h3.59l-9.3 9.29a1 1 0 0 0 1.42 1.42L18 8.41V12a1 1 0 0 0 2 0V6a1 1 0 0 0-1-1h-6Z"
                    />
                  </svg>
                </LinkTo>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-app">
      <div
        class="relative overflow-hidden rounded-[32px] bg-white/95 p-6 shadow-2xl shadow-emerald-100 ring-1 ring-emerald-100/70 sm:p-8"
      >
        <div
          class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-r from-emerald-50 via-white to-teal-50"
        ></div>
        <div
          class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-emerald-200/40 blur-3xl"
        ></div>
        <div
          class="pointer-events-none absolute -left-20 bottom-0 h-56 w-56 rounded-full bg-teal-200/30 blur-3xl"
        ></div>

        <div
          class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]"
        >
          <div class="space-y-6">
            <p
              class="text-xs font-semibold uppercase tracking-[0.28em] text-emerald-700"
            >{{this.contactCopy.eyebrow}}</p>
            <h2
              class="text-3xl font-bold leading-tight text-slate-900 sm:text-4xl"
            >
              {{this.contactCopy.title}}
            </h2>
            <p class="text-lg leading-relaxed text-slate-600">
              {{this.contactCopy.description}}
            </p>

            <div class="grid gap-3 sm:grid-cols-2">
              {{#each this.contactCopy.bullets as |item|}}
                <div
                  class="flex items-start gap-3 rounded-2xl bg-emerald-50 px-4 py-3 text-emerald-900 ring-1 ring-emerald-100"
                >
                  <span
                    class="mt-1 flex h-7 w-7 items-center justify-center rounded-xl bg-white/80 text-emerald-700 ring-1 ring-emerald-100"
                  >
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      class="h-4 w-4 fill-current"
                    >
                      <path
                        d="M20.71 5.29a1 1 0 0 0-1.42 0L9 15.59l-4.29-4.3a1 1 0 0 0-1.42 1.42l5 5a1 1 0 0 0 1.42 0l11-11a1 1 0 0 0 0-1.42Z"
                      />
                    </svg>
                  </span>
                  <span
                    class="text-sm font-medium leading-relaxed"
                  >{{item}}</span>
                </div>
              {{/each}}
            </div>

            <div
              class="space-y-3 rounded-2xl bg-slate-900 px-5 py-4 text-slate-100 shadow-lg shadow-slate-900/25 ring-1 ring-slate-800/60"
            >
              <div
                class="text-sm font-semibold"
              >{{this.contactCopy.directTitle}}</div>
              <div
                class="text-sm text-slate-300"
              >{{this.contactCopy.directDesc}}</div>
              <div class="flex flex-wrap gap-3 text-sm font-semibold">
                <a
                  class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-2 text-emerald-100 ring-1 ring-white/15 transition hover:bg-white/15"
                  href="tel:024202844"
                >
                  02-420-2844~5
                </a>
                <a
                  class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-2 text-emerald-100 ring-1 ring-white/15 transition hover:bg-white/15"
                  href="mailto:ct4138605@gmail.com"
                >
                  ct4138605@gmail.com
                </a>
              </div>
            </div>
          </div>

          <form
            class="space-y-5 rounded-3xl bg-white/90 p-6 shadow-xl shadow-emerald-100 ring-1 ring-emerald-100/80 backdrop-blur"
            {{on "submit" this.submitForm}}
          >
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="space-y-2 text-sm font-semibold text-slate-700">
                <span>{{this.contactCopy.nameLabel}}</span>
                <input
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-base text-slate-900 shadow-sm transition focus:border-emerald-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-200"
                  type="text"
                  value={{this.name}}
                  required
                  {{on "input" (fn this.updateField "name")}}
                />
              </label>
              <label class="space-y-2 text-sm font-semibold text-slate-700">
                <span>{{this.contactCopy.emailLabel}}</span>
                <input
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-base text-slate-900 shadow-sm transition focus:border-emerald-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-200"
                  type="email"
                  value={{this.email}}
                  required
                  {{on "input" (fn this.updateField "email")}}
                />
              </label>
              <label class="space-y-2 text-sm font-semibold text-slate-700">
                <span>{{this.contactCopy.phoneLabel}}</span>
                <input
                  class="w-full rounded-xl border border-dashed border-slate-200 bg-white px-4 py-3 text-base text-slate-900 transition focus:border-emerald-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-200"
                  type="text"
                  value={{this.phone}}
                  placeholder="010-1234-5678"
                  {{on "input" (fn this.updateField "phone")}}
                />
              </label>
              <label class="space-y-2 text-sm font-semibold text-slate-700">
                <span>{{this.contactCopy.companyLabel}}</span>
                <input
                  class="w-full rounded-xl border border-dashed border-slate-200 bg-white px-4 py-3 text-base text-slate-900 transition focus:border-emerald-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-200"
                  type="text"
                  value={{this.company}}
                  {{on "input" (fn this.updateField "company")}}
                />
              </label>
            </div>

            <label class="space-y-2 text-sm font-semibold text-slate-700">
              <span>{{this.contactCopy.messageLabel}}</span>
              <textarea
                class="min-h-[160px] w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-base text-slate-900 shadow-sm transition focus:border-emerald-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-200"
                value={{this.message}}
                required
                placeholder={{this.contactCopy.messagePlaceholder}}
                {{on "input" (fn this.updateField "message")}}
              ></textarea>
            </label>

            <div class="space-y-3">
              {{#if this.isSuccess}}
                <div
                  class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"
                >
                  {{this.contactCopy.successMessage}}
                </div>
              {{/if}}

              {{#if this.isError}}
                <div
                  class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"
                >
                  {{this.errorMessage}}
                </div>
              {{/if}}

              <button
                type="submit"
                class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-500 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-emerald-500/25 transition hover:from-emerald-500 hover:via-emerald-500 hover:to-teal-500 disabled:cursor-not-allowed disabled:opacity-70"
                disabled={{this.submitDisabled}}
              >
                {{#if this.isSubmitting}}
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    class="h-5 w-5 animate-spin fill-white/80"
                  >
                    <path
                      d="M12 2a10 10 0 0 0-9.54 7.06 1 1 0 1 0 1.92.56A8 8 0 1 1 4 12a1 1 0 0 0-2 0 10 10 0 1 0 10-10Z"
                    />
                  </svg>
                {{/if}}
                <span>{{this.buttonLabel}}</span>
              </button>

              <p
                class="text-xs text-slate-500"
              >{{this.contactCopy.privacyNote}}</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</div>