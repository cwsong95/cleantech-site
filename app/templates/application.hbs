<header class="site-header">
  <div class="container-app site-header__bar">
    <LinkTo @route="index" class="brand"><img
        src="/images/cleantech-logo.jpg"
        alt="Polished Aqua-Crete floor"
        class="clean-tech-img"
      /></LinkTo>

    <nav
      id="primary-navigation"
      class="nav {{if this.mobileNavOpen 'nav--open'}}"
      aria-label="Primary"
    >
      <div
        class="dropdown {{if this.productsOpen 'is-open'}}"
        {{on "mouseenter" this.openProductsDropdown}}
        {{on "mouseleave" this.closeProductsDropdown}}
        {{on "focusin" this.openProductsDropdown}}
        {{on "focusout" this.handleDropdownFocusOut}}
      >
        <button
          type="button"
          class="nav-link nav-link--trigger"
          aria-haspopup="true"
          aria-expanded={{if this.productsOpen "true" "false"}}
          aria-controls="products-menu"
          {{on "click" this.toggleProductsDropdown}}
        >
          {{this.locale.t "nav.products"}}
          <svg class="caret" viewBox="0 0 24 24"><path
              d="M6 9l6 6 6-6"
            ></path></svg>
        </button>
        <div class="dropdown-menu" id="products-menu">
          <div class="dropdown-group-header">AQUA-CRETE</div>
          <LinkTo
            @route="product.aqua-crete"
            class="dropdown-item"
            {{on "click" this.closeMobileNav}}
          >{{this.locale.t "dropdown.aquaFloor"}}</LinkTo>
          <LinkTo
            @route="product.aqua-crete-eifs"
            class="dropdown-item"
            {{on "click" this.closeMobileNav}}
          >{{this.locale.t "dropdown.aquaWall"}}</LinkTo>

          <div class="dropdown-divider"></div>
          <div class="dropdown-group-header">SKY</div>
          <LinkTo
            @route="product.sky-floor"
            class="dropdown-item"
            {{on "click" this.closeMobileNav}}
          >{{this.locale.t "dropdown.skyFloor"}}</LinkTo>
          <span
            class="dropdown-item dropdown-item--disabled"
            title="준비중"
          >
            <span>{{this.locale.t "dropdown.skyFlex"}}</span>
            <span class="dropdown-badge">{{this.locale.t "dropdown.comingSoon"}}</span>
          </span>

          <div class="dropdown-divider"></div>
          <div class="dropdown-group-header">
            <span>{{this.locale.t "dropdown.polyaspartic"}}</span>
            <span class="dropdown-badge">{{this.locale.t "dropdown.comingSoon"}}</span>
          </div>
          <span
            class="dropdown-item dropdown-item--disabled"
            title="준비중"
          >{{this.locale.t "dropdown.polyWaterproof"}}</span>
          <span
            class="dropdown-item dropdown-item--disabled"
            title="준비중"
          >{{this.locale.t "dropdown.polyPrimer"}}</span>
        </div>
      </div>
      <LinkTo
        @route="company"
        class="nav-link"
        {{on "click" this.closeMobileNav}}
      >{{this.locale.t "nav.company"}}</LinkTo>

      <LinkTo
        @route="certifications"
        class="nav-link"
        {{on "click" this.closeMobileNav}}
      >{{this.locale.t "nav.certifications"}}</LinkTo>
      <LinkTo
        @route="contact"
        class="nav-link"
        {{on "click" this.closeMobileNav}}
      >{{this.locale.t "nav.contact"}}</LinkTo>

      <button
        type="button"
        class="lang-toggle md:hidden"
        aria-label={{this.locale.toggleAriaLabel}}
        {{on "click" this.toggleLocale}}
      >
        {{this.locale.toggleLabel}}
      </button>
    </nav>

    <div class="site-header__actions">
      <button
        type="button"
        class="lang-toggle hidden md:inline-flex"
        aria-label={{this.locale.toggleAriaLabel}}
        {{on "click" this.toggleLocale}}
      >
        {{this.locale.toggleLabel}}
      </button>

      <button
        type="button"
        class="menu-toggle md:hidden"
        aria-expanded={{if this.mobileNavOpen "true" "false"}}
        aria-controls="primary-navigation"
        aria-label={{if
          this.mobileNavOpen
          (if this.locale.isKorean "메뉴 닫기" "Close menu")
          (if this.locale.isKorean "메뉴 열기" "Open menu")
        }}
        {{on "click" this.toggleMobileNav}}
      >
        {{#if this.mobileNavOpen}}
          <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5"><path
              d="M6.2 5.8a1 1 0 0 0-1.4 1.4L10.6 13l-5.8 5.8a1 1 0 1 0 1.4 1.4L12 14.4l5.8 5.8a1 1 0 0 0 1.4-1.4L13.4 13l5.8-5.8a1 1 0 0 0-1.4-1.4L12 11.6Z"
            /></svg>
        {{else}}
          <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5"><path
              d="M4 6a1 1 0 1 0 0 2h16a1 1 0 1 0 0-2H4Zm0 5a1 1 0 1 0 0 2h16a1 1 0 1 0 0-2H4Zm0 5a1 1 0 1 0 0 2h16a1 1 0 1 0 0-2H4Z"
            /></svg>
        {{/if}}
      </button>
    </div>
  </div>

  {{#if this.mobileNavOpen}}
    <button
      type="button"
      class="nav-backdrop md:hidden"
      aria-label={{if this.locale.isKorean "메뉴 닫기" "Close menu"}}
      {{on "click" this.closeMobileNav}}
    ></button>
  {{/if}}
</header>

<main class="page">
  <div class="container-app">
    {{outlet}}
  </div>
</main>

<footer class="site-footer">
  <div class="footer-wrap">
    <div>
      <div class="font-semibold flex items-center gap-2">
        <img
          src="/images/cleantech-icon.jpg"
          alt=""
          aria-hidden="true"
          class="h-5 w-auto object-contain"
        />
        {{this.locale.t "footer.company.name"}}
      </div>
      <div class="text-white/80 mt-2">
        {{this.locale.t "footer.company.address"}}
      </div>
      <div class="text-white/80">
        {{this.locale.t "footer.company.contact"}}
      </div>
      <p class="text-white/50">
        {{this.locale.t "footer.company.copyright"}}
      </p>
    </div>
    <div>
      <div class="font-semibold">
        {{this.locale.t "footer.certifications.title"}}
      </div>
      <ul class="list-disc ml-5 text-white/80 mt-2">
        {{#each (this.locale.t "footer.certifications.items") as |item|}}
          <li>{{item}}</li>
        {{/each}}
      </ul>
    </div>
    <div>
      <div class="font-semibold">
        {{this.locale.t "footer.downloads.title"}}
      </div>
      <LinkTo
        @route="downloads"
        class="mt-2 flex items-center gap-2 text-white/80 catalog"
      >
        {{this.locale.t "footer.downloads.link"}}
      </LinkTo>
    </div>
  </div>
</footer>