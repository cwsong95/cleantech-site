{{page-title this.copy.metaTitle}}

<article class="resources-page page ac-page full-bleed" {{aqua-reveal}}>
  {{! ================= HERO ================= }}
  <section class="ac-hero ac-hero--slim">
    <div class="ac-inner ac-hero__grid ac-hero__grid--solo">
      <div class="ac-hero__content">
        <span class="ac-hero__eyebrow"><span
          >{{this.copy.hero.eyebrow}}</span></span>
        <h1 class="ac-hero__title">{{this.copy.hero.title}}</h1>
        <p class="ac-hero__lead">{{break-lines this.copy.hero.description}}</p>
      </div>
    </div>
  </section>

  <div class="margin-page">
    <section class="ac-sec ac-resources">
      {{! ================= TAB BAR ================= }}
      <div class="ac-galtabs__bar ac-reveal">
        {{#each this.tabs as |tab|}}
          <button
            type="button"
            class="ac-galtab {{if tab.active 'is-active'}}"
            {{on "click" (fn this.select tab.id)}}
          >{{tab.label}}<i class="ac-galtab__n">{{tab.count}}</i></button>
        {{/each}}
      </div>

      {{! ================= 자료실 ================= }}
      {{#if this.isDownloads}}
        <div class="rz-grid rz-grid--doc">
          {{#each this.downloads as |card|}}
            <article
              class="rz-doc rz-doc--cover
                {{unless card.available 'rz-doc--soon'}}"
            >
              <figure class="rz-doc__fig">
                {{#if card.image}}
                  <img src={{card.image}} alt={{card.name}} loading="lazy" />
                {{else}}
                  <span class="rz-doc__ph">{{this.copy.comingSoon}}</span>
                {{/if}}
              </figure>
              <div class="rz-doc__cap">
                <div class="rz-doc__caphead">
                  <h3>{{card.name}}</h3>
                  {{#unless card.available}}<span
                      class="rz-badge"
                    >{{this.copy.comingSoon}}</span>{{/unless}}
                </div>
                <p>{{card.summary}}</p>
                {{#if card.available}}
                  <a class="rz-dlbtn" href={{card.href}} download>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ><path d="M12 3v12" /><path d="m7 11 5 5 5-5" /><path
                        d="M5 21h14"
                      /></svg>
                    {{this.copy.actions.download}}
                  </a>
                {{/if}}
              </div>
            </article>
          {{/each}}
        </div>
      {{/if}}

      {{! ================= 인증서 (작게만 표시) ================= }}
      {{#if this.isCerts}}
        <div class="rz-grid rz-grid--doc">
          {{#each this.certificates as |doc|}}
            <article class="rz-doc">
              <figure class="rz-doc__fig">
                <img src={{doc.image}} alt={{doc.title}} loading="lazy" />
              </figure>
              <div class="rz-doc__cap">
                <h3>{{doc.title}}</h3>
                <p>{{doc.summary}}</p>
              </div>
            </article>
          {{/each}}
        </div>
      {{/if}}

      {{! ================= 시험성적표 (작게만 표시) ================= }}
      {{#if this.isReports}}
        <div class="rz-grid rz-grid--doc">
          {{#each this.reports as |doc|}}
            <article class="rz-doc">
              <figure class="rz-doc__fig">
                <img src={{doc.image}} alt={{doc.title}} loading="lazy" />
              </figure>
              <div class="rz-doc__cap">
                <h3>{{doc.title}}</h3>
                <p>{{doc.summary}}</p>
              </div>
            </article>
          {{/each}}
        </div>
      {{/if}}
    </section>
  </div>
</article>